# Copy to .env and fill in real values. .env is git-ignored -- never commit it.
#
# Same Supabase project as frontend/.env, ml/option_one/.env, and
# backend/reconciliation/.env -- the anon key already has select on
# `readings` and `sensor_calibration` via RLS, which is all this pipeline
# needs (read-only, no writes to Supabase). Format mirrors
# ml/option_one/.env.example; if this file is absent, configs/site.py
# falls back to frontend/.env's VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key-here
