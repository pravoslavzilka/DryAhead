# Copy this file to .env and fill in real values. .env is git-ignored -- never
# commit it.
#
# Use the Supabase ANON key here, not the service_role key. This script only
# needs `select` on readings and `select`+`insert` on instructions, which the
# anon key can be scoped to via RLS policies (see README.md). The service_role
# key bypasses RLS entirely and should never be used by this script.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key-here
